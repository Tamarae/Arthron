  "attestations": [
    {
      "ref": "§ 7",
      "source": "treatise",
      "context": "ხოლო შობილობითად რაჲ იტყოდინიტყ̃დიან საზღვართაებრ მათთა…"
    },
    {
      "ref": "§ 9",
      "source": "treatise",
      "context": "ხოლო განმრავლებითთაგანმრავლებითა რაჲ იტყოდინიტყ̃დიან სახელთასახელსა ღმერთთასა,…"
    },
    {
      "ref": "§ 13",
      "source": "treatise",
      "context": "რამეთუ სამებისა სახელი დედალი არს და ითქუმის ესრეთ: ტრიას τριάς. ხოლო…"
    },
    {
      "ref": "§ 14",
      "source": "treatise",
      "context": "ხოლო ორობითნი არიან ესე: რაჟამს ორთა პირთა ცხად-ჰყოფდენჰყოფენ უართრონოდ: ტრიადე…"
    },
    {
      "ref": "§ 15",
      "source": "treatise",
      "context": "ხოლო მრავალთა რაჲ პირთა ცხად-ჰყოფდენ ადვილობითადადვილობითად და,…"
    },
    {
      "ref": "§ 17",
      "source": "treatise",
      "context": "და სულსა წმიდასა არა მამალი ეწოდების სახელი, არცა დედალი, არამედ შუაჲშუა.…"
    },
    {
      "ref": "¶ 16",
      "source": "research",
      "context": "მოქმედებითი ბრუნვის ფორმანტი -ით მრავალი სპეციალური ტერმინის საწარმოებლად არის…"
    },
    {
      "ref": "კვლევა ე",
      "source": "research",
      "context": "ბერძნულ ართრონთა და სიტყვათათვის დასახელებული ხუთი ბრუნვა შემდეგია: ადვილობითი…"
    }
