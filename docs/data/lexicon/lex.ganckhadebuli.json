  "ontolex:sense": [
    {
      "@type": "ontolex:LexicalSense",
      "skos:definition": [
        {
          "@value": "აშკარა, თვალით სახილველი.",
          "@language": "ka"
        }
      ]
    }
  ],
  "attestations": [
    {
      "ref": "ჰ. 20",
      "source": "homily",
      "context": "ამით პავლე და წამებასაცა შემოართუამს დამბეჭდველი თავისა(?) თჳსისაჲ (?)…"
    },
    {
      "ref": "ჰ. 22",
      "source": "homily",
      "context": "ესრეთ უკუე „აღსლვაჲ“ და „შთასლვაჲ“ ნამეტავად პოოს ვინმე, ხოლო საკუთრად…"
    },
    {
      "ref": "ჰ. 30",
      "source": "homily",
      "context": "ხოლო რომელი მრავალ გზის მითქუამს, მომღებელი აწ კუალადცა ვიტყჳ, რაჲთა არა ვისი…"
    },
    {
      "ref": "ჰ. 35",
      "source": "homily",
      "context": "კანონნი ესე სადაჲთ მიგიხუმან, ჵ ამაოო მწვალებელო და არა-ღმრთისმეტყუელო?…"
    },
    {
      "ref": "ჰ. 37",
      "source": "homily",
      "context": "კუალად უკუე ნეტარმან თომა, ერთმან მოციქულთაგანმან, ურწმუნო-ქმნილმან მაცხოვრისა…"
    },
    {
      "ref": "ჰ. 60",
      "source": "homily",
      "context": "ხოლო განცხადებულად ისმინე სულისა წმიდისათჳს თქუმული: ამას იტყჳს უფალი ყოვლისა…"
    },
    {
      "ref": "ჰ. 70",
      "source": "homily",
      "context": "და იხილე სიტყუათა ერთჴმაობაჲ მამისათჳს თქუმულთა და სულისათჳს, რამეთუ პავლე…"
    }
  ]
