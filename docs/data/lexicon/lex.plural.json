  "attestations": [
    {
      "ref": "§ 5",
      "source": "treatise",
      "context": "ორობითთანიცაორობითნიცა ხუთნი არიან და განმრავლებითთანიცა; გარნა ორობითთასა…"
    },
    {
      "ref": "§ 9",
      "source": "treatise",
      "context": "ხოლო განმრავლებითთაგანმრავლებითა რაჲ იტყოდინიტყ̃დიან სახელთასახელსა ღმერთთასა,…"
    },
    {
      "ref": "§ 11",
      "source": "treatise",
      "context": "ესრეთესე ორი ძალი აქუს ლექსსალექსაღ̃ისსა ამას და ერთითა გუარითა ითქუმის ორივე…"
    },
    {
      "ref": "§ 18",
      "source": "treatise",
      "context": "ხოლო განმრავლებითნი უართრონონი: პნევმატა πνεύματα, პნევმატონ πνευμάτων,…"
    },
    {
      "ref": "§ 20",
      "source": "treatise",
      "context": "ესრეთვე და დედალნი ართრონნი სამებისანი, ვითარმედ: ი სამებაჲ, ტის…"
    },
    {
      "ref": "¶ 8",
      "source": "research",
      "context": "მრავლობითი რიცხვი. მრავლობითი რიცხვის საწარმოებლად იხმარება თ-ანიანი…"
    },
    {
      "ref": "¶ 16",
      "source": "research",
      "context": "მოქმედებითი ბრუნვის ფორმანტი -ით მრავალი სპეციალური ტერმინის საწარმოებლად არის…"
    },
    {
      "ref": "კვლევა ე",
      "source": "research",
      "context": "ბერძნული ტრადიციის მიხედვით, გრამატიკულ ტრაქტატში სახელთა და ართრონთათვის…"
    }
  ]
