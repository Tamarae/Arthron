  "attestations": [
    {
      "ref": "§ 1",
      "source": "treatise",
      "context": "შეისწავე, რამეთუ ვინაჲთგან ართრონთა ძლით უმეცრადუმეცრ̃დ და ბნელად საგონებელ არს…"
    },
    {
      "ref": "§ 10",
      "source": "treatise",
      "context": "რამეთუ ბერძულად განყოფილებაჲ აქუს მიცემითსა და მიზეზობითსა, ვითარცა ზემოზემოთ…"
    },
    {
      "ref": "ჰ. 18",
      "source": "homily",
      "context": "აწ უკუე ითქუა წინაჲსწარმეტყუელთა მიერ წინაჲსწარმეტყუელებული; ხოლო ითქუა არა…"
    },
    {
      "ref": "ჰ. 28",
      "source": "homily",
      "context": "იტყჳან უკუე მწვალებელნი ძისა უარის-მყოფელნი, უფროჲსღა თავთა თჳსთა მაცხოარებისა…"
    },
    {
      "ref": "ჰ. 29",
      "source": "homily",
      "context": "აწ უკუე უკუეთუ ჰპოებ სახელდებით მამასა ყოვლისა მპყრობელად დაწერილსა, მიგუჴდიდ…"
    },
    {
      "ref": "ჰ. 38",
      "source": "homily",
      "context": "არამედ გამოსაჩინებელნი ესე არიან ვიდრემე სახარებისანი, და რამეთუ თომა…"
    },
    {
      "ref": "ჰ. 70",
      "source": "homily",
      "context": "და იხილე სიტყუათა ერთჴმაობაჲ მამისათჳს თქუმულთა და სულისათჳს, რამეთუ პავლე…"
    }
  ]
