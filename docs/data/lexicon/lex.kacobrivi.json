  "ontolex:sense": [
    {
      "@type": "ontolex:LexicalSense",
      "skos:definition": [
        {
          "@value": "ადამიანური, ადამიანისათვის დამახასიათებელი.",
          "@language": "ka"
        }
      ]
    }
  ],
  "attestations": [
    {
      "ref": "ჰ. 1",
      "source": "homily",
      "context": "გუშინ, ჩუენ, ჵ ქრისტეს მოყუარენო, წინაჲსწარმეტყუელთა და მახარებელთა შემოსრულთა…"
    },
    {
      "ref": "ჰ. 2",
      "source": "homily",
      "context": "ყოვლითურთ ვიდრემე ჭეშმარიტებისმოყუარებით თქუმითა არავის კაცთაგანსა ძალ-უც…"
    },
    {
      "ref": "ჰ. 4",
      "source": "homily",
      "context": "გაჴსოვს უკუე — და რამეთუ არა უწესო არს კუალად მოჴსენებად — თუ ვითარ…"
    },
    {
      "ref": "ჰ. 14",
      "source": "homily",
      "context": "ხედავა, ვითარ კაცობრივი მოძღურებაჲ ურჩებად იქმნების ღმრთისა? მოძღურებასა…"
    },
    {
      "ref": "ჰ. 25",
      "source": "homily",
      "context": "ხოლო ვინაჲთგან ძმათა ვიეთმე მოსწრაფეთაგანთა სულისა წმიდისათჳს ითხოეს სიტყუაჲ…"
    },
    {
      "ref": "ჰ. 44",
      "source": "homily",
      "context": "აწ უკუე ნუ წარმოადგინებ ვითარცა უცხოსა ბუნებისასა ღმრთისა მიმართ თქუმულთა;…"
    },
    {
      "ref": "ჰ. 49",
      "source": "homily",
      "context": "და მრავლად ამის-შემდგომად მეტყუელმან, ვინაჲთგან საცთურსა მათსა პირველ…"
    }
  ]
}