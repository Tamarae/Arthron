<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://www.tei-c.org/release/xml/tei/custom/schema/relaxng/tei_all.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:lang="ka">
    <teiHeader>
        <fileDesc>
            <titleStmt>
                <title xml:lang="ka">სიტყუა ართრონთათჳს: სრული ციფრული ლექსიკონი</title>
                <title xml:lang="en">Discourse on Articles: Complete Digital Lexicon</title>
                <author>Mzekala Shanidze (Original Edition)</author>
            </titleStmt>
            <publicationStmt>
                <publisher>Digital Scholarly Edition</publisher>
                <date when="2025">2025</date>
                <idno type="cts-urn">urn:cts:georgian:shanidze.arthron.lexicon</idno>
            </publicationStmt>
            <sourceDesc>
                <p>Compiled from the Old Georgian treatise text and the lexicographical appendix provided in the scholarly edition.</p>
            </sourceDesc>
        </fileDesc>
    </teiHeader>
    <text>
        <body>
            <div type="lexicon">
                <!-- ა -->
                <entry xml:id="lex.agebuli">
                    <form type="lemma"><orth xml:lang="ka">აგებული</orth></form>
                    <sense><def xml:lang="ka">შექმნილი, მატერიალური, არსებული.</def></sense>
                    <cit type="example"><quote xml:lang="ka">გრძნობადი ნათელი უძღვს თუალსა აგებულთა გულის მის-ყოფად.</quote></cit>
                </entry>

                <entry xml:id="lex.adviloba" corresp="http://purl.org/olia/olia.owl#Nominative">
                    <form type="lemma">
                        <orth xml:lang="ka">ადვილობა</orth>
                        <orth type="variant" xml:lang="ka">ადვილობითი</orth>
                    </form>
                    <xr type="map"><ref target="#lex.nom"/></xr>
                    <sense><def xml:lang="ka">მარტივი, სახელობითი ბრუნვა (ბერძნ. ὀνομαστική).</def></sense>
                    <cit type="example"><quote xml:lang="ka">რაჟამს ადვილობითად იჴმევდენ ჴსენებასა სახელისასა.</quote><bibl>§ 4</bibl></cit>
                </entry>
                <entry xml:id="lex.nom" corresp="http://purl.org/olia/olia.owl#Nominative"><form type="lemma"><orth xml:lang="ka">სახელობითი</orth></form><xr type="see"><ref target="#lex.adviloba"/></xr></entry>

                <entry xml:id="lex.antipa">
                    <form type="lemma"><orth xml:lang="ka">ანტიპა</orth></form>
                    <note>ნ. გვ. 110.</note>
                </entry>

                <entry xml:id="lex.arthron" corresp="http://purl.org/olia/olia.owl#Article">
                    <form type="lemma"><orth xml:lang="ka">ართრონი</orth></form>
                    <etym><lang>grc</lang><mentioned xml:lang="grc">ἄρθρον</mentioned></etym>
                    <sense><def xml:lang="ka">განსაზღვრებითი ნაწევარი, არტიკლი.</def></sense>
                    <cit type="example"><quote xml:lang="ka">ართრონსა დაუდებს.</quote><bibl>ჰ. 34</bibl></cit>
                    <cit type="example"><quote xml:lang="ka">ართრონთა ძლით უმეცრად და ბნელად საგონებელ არს.</quote><bibl>§ 1</bibl></cit>
                </entry>

                <entry xml:id="lex.arthroniani">
                    <form type="lemma"><orth xml:lang="ka">ართრონიანი</orth></form>
                    <sense><def xml:lang="ka">არტიკლიანი (სახელი).</def></sense>
                    <cit type="example"><quote xml:lang="ka">„ო თეოს“ არს ღმერთი ართრონიანი.</quote><bibl>ჰ. 34</bibl></cit>
                </entry>

                <entry xml:id="lex.arianozi">
                    <form type="lemma"><orth xml:lang="ka">არიანოზი</orth></form>
                    <sense><def xml:lang="ka">არიოსის მიმდევარი, მწვალებელი.</def></sense>
                    <cit type="example"><quote xml:lang="ka">მწვალებლებრი საცთური არიანოზთად.</quote><bibl>ჰ. 27</bibl></cit>
                </entry>

                <entry xml:id="lex.aghgeba">
                    <form type="lemma"><orth xml:lang="ka">აღგება</orth></form>
                    <sense><def xml:lang="ka">შექმნა.</def></sense>
                    <cit type="example"><quote xml:lang="ka">სამებისა მიერ აღვეგენით.</quote><bibl>ჰ. 75</bibl></cit>
                </entry>

                <entry xml:id="lex.aghvseba">
                    <form type="lemma"><orth xml:lang="ka">აღვსება</orth></form>
                    <cit type="example"><quote xml:lang="ka">სიტყუასა მას უართრონოსა და აღუვსნის მრავალთა გამოსაჩინებელთა მიერ.</quote><bibl>§ 21</bibl></cit>
                </entry>

                <entry xml:id="lex.aghmgebeli">
                    <form type="lemma"><orth xml:lang="ka">აღმგებელი</orth></form>
                    <etym><lang>grc</lang><mentioned xml:lang="grc">τεκταιნόμενος</mentioned></etym>
                    <sense><def xml:lang="ka">შემქმნელი.</def></sense>
                    <cit type="example"><quote xml:lang="ka">მე ვარ აღმგებელი ქუეყანისად.</quote><bibl>ჰ. 60</bibl></cit>
                </entry>

                <entry xml:id="lex.aghmoceneba">
                    <form type="lemma"><orth xml:lang="ka">აღმოცენება</orth></form>
                    <cit type="example"><quote xml:lang="ka">აღმატებაჲ სიმართლისად აღმოეცენა.</quote><bibl>ჰ. 11</bibl></cit>
                </entry>

                <entry xml:id="lex.aghmochra">
                    <form type="lemma"><orth xml:lang="ka">აღმოჭრა</orth></form>
                    <sense><def xml:lang="ka">მოსპობა.</def></sense>
                    <cit type="example"><quote xml:lang="ka">ძირითგან აღმოსჭრას ცილისწამებაჲ.</quote><bibl>ჰ. 44</bibl></cit>
                </entry>

                <entry xml:id="lex.aghmokhdoma">
                    <form type="lemma"><orth xml:lang="ka">აღმოჴდომა</orth></form>
                    <sense><def xml:lang="ka">ამოსვლა.</def></sense>
                    <cit type="example"><quote xml:lang="ka">მაღლით ცა აღმოჰჴდების.</quote><bibl>ჰ. 9</bibl></cit>
                </entry>

                <entry xml:id="lex.aghrackhuli">
                    <form type="lemma"><orth xml:lang="ka">აღრაცხული</orth></form>
                    <sense><def xml:lang="ka">ჩათვლილი.</def></sense>
                    <cit type="example"><quote xml:lang="ka">არა წინაჲსწარმეტყუელთა შორის აღრაცხულისა.</quote><bibl>ჰ. 9</bibl></cit>
                </entry>

                <entry xml:id="lex.aghqvaneba">
                    <form type="lemma"><orth xml:lang="ka">აღყვანება</orth></form>
                    <cit type="example"><quote xml:lang="ka">არა მთარგმანებელსა ზედა აღიყვანების სიტყუაჲ.</quote><bibl>ჰ. 14</bibl></cit>
                </entry>

                <!-- ბ -->
                <entry xml:id="lex.borgneuli">
                    <form type="lemma"><orth xml:lang="ka">ბორგნეული</orth></form>
                    <etym><lang>grc</lang><mentioned xml:lang="grc">λυττῶντες</mentioned></etym>
                    <sense><def xml:lang="ka">მებრძოლი, აღგზნებული.</def></sense>
                    <cit type="example"><quote xml:lang="ka">სამებისა ენათა აღმლესელნი და ბორგნეულნი.</quote><bibl>გვ. 40</bibl></cit>
                </entry>

                <entry xml:id="lex.brgunva">
                    <form type="lemma"><orth xml:lang="ka">ბრგუნვა</orth></form>
                    <sense><def xml:lang="ka">ენამძიმედ, ენადაბმულად მეტყველება.</def></sense>
                    <cit type="example"><quote xml:lang="ka">დაღაცათუ ვბრგუნვილობთ, არამედ ბრგუნვასა შინა მშჳდობასა ვქადაგებთ.</quote><bibl>ჰ. 18</bibl></cit>
                </entry>

                <entry xml:id="lex.brgunvili">
                    <form type="lemma"><orth xml:lang="ka">ბრგუნვილი</orth></form>
                    <sense><def xml:lang="ka">ცუდად, მძიმედ გამოთქმული.</def></sense>
                </entry>

                <entry xml:id="lex.buneba">
                    <form type="lemma"><orth xml:lang="ka">ბუნება</orth></form>
                    <sense><def xml:lang="ka">მატერიალური, ფიზიკური ნაწილი (სხეულისა).</def></sense>
                    <cit type="example"><quote xml:lang="ka">გრძნობადი ვიდრე-მე ნათელი განატფობს სხეულთა ბუნებასა.</quote><bibl>ჰ. 3</bibl></cit>
                </entry>

                <!-- გ -->
                <entry xml:id="lex.gamometqueli">
                    <form type="lemma"><orth xml:lang="ka">გამომეტყუელი</orth></form>
                    <sense><def xml:lang="ka">მთხრობი, ავტორი.</def></sense>
                </entry>

                <entry xml:id="lex.gamomtkhovneli">
                    <form type="lemma"><orth xml:lang="ka">გამომთხოვნელი</orth></form>
                </entry>

                <entry xml:id="lex.gamoparva">
                    <form type="lemma"><orth xml:lang="ka">გამოპარვა</orth></form>
                    <sense><def xml:lang="ka">უჩუმრად, შეუმჩნევლად შემოსვლა.</def></sense>
                </entry>

                <entry xml:id="lex.gamosachinebeli">
                    <form type="lemma"><orth xml:lang="ka">გამოსაჩინებელი</orth></form>
                    <sense><def xml:lang="ka">მაგალითი.</def></sense>
                    <cit type="example"><quote xml:lang="ka">აღუვსნის მრავალთა გამოსაჩინებელთა მიერ.</quote><bibl>§ 21</bibl></cit>
                </entry>

                <entry xml:id="lex.ganmtkumeli">
                    <form type="lemma"><orth xml:lang="ka">განმთქუმელი</orth></form>
                    <etym><lang>grc</lang><mentioned xml:lang="grc">καταγγελεύς</mentioned></etym>
                    <sense><def xml:lang="ka">განმცხადებელი, ამბის გამავრცელებელი.</def></sense>
                </entry>

                <entry xml:id="lex.ganmkacreba">
                    <form type="lemma"><orth xml:lang="ka">განმკაცრება</orth></form>
                    <etym><lang>grc</lang><mentioned xml:lang="grc">ἀκρίβεια</mentioned></etym>
                    <sense><def xml:lang="ka">დაწვრილებით გამოძიება, ჩაძიება.</def></sense>
                    <cit type="example"><quote xml:lang="ka">განმკაცრდი ჩემდა გამოწულილვით.</quote><bibl>ჰ. 56</bibl></cit>
                </entry>

                <entry xml:id="lex.ganmcdeloba">
                    <form type="lemma"><orth xml:lang="ka">განმცდელობა</orth></form>
                    <sense><def xml:lang="ka">ცდა.</def></sense>
                </entry>

                <entry xml:id="lex.ganmkhilveli">
                    <form type="lemma"><orth xml:lang="ka">განმხილველი</orth></form>
                    <sense><def xml:lang="ka">განხილვა, მოფიქრება.</def></sense>
                </entry>

                <entry xml:id="lex.ganmvedreba">
                    <form type="lemma"><orth xml:lang="ka">განმვედრება</orth></form>
                    <sense><def xml:lang="ka">გაძლიერება.</def></sense>
                </entry>

                <entry xml:id="lex.gansazghvreba">
                    <form type="lemma"><orth xml:lang="ka">განსაზღვრება</orth></form>
                    <etym><lang>grc</lang><mentioned xml:lang="grc">ὥρισεν</mentioned></etym>
                    <sense><def xml:lang="ka">დადგენა.</def></sense>
                </entry>

                <entry xml:id="lex.gansazghvrebuli">
                    <form type="lemma"><orth xml:lang="ka">განსაზღვრებული</orth></form>
                    <sense><def xml:lang="ka">დადგენილი.</def></sense>
                </entry>

                <entry xml:id="lex.ganqofileba">
                    <form type="lemma"><orth xml:lang="ka">განყოფილება</orth></form>
                    <sense><def xml:lang="ka">განსხვავებულობა, სხვადასხვაობა.</def></sense>
                    <cit type="example"><quote xml:lang="ka">ბერძულად განყოფილებაჲ აქუს მიცემითსა და მიზეზობითსა.</quote><bibl>§ 10</bibl></cit>
                </entry>

                <entry xml:id="lex.ganchineba">
                    <form type="lemma"><orth xml:lang="ka">განჩინება</orth></form>
                    <cit type="example"><quote xml:lang="ka">დასჯასა მას ადამისსა პირველად განჩინებაი შემოიღო.</quote><bibl>ჰ. 10</bibl></cit>
                </entry>

                <entry xml:id="lex.gancdili">
                    <form type="lemma"><orth xml:lang="ka">განცდილი</orth></form>
                    <sense><def xml:lang="ka">ნახული.</def></sense>
                </entry>

                <entry xml:id="lex.ganckhadebuli">
                    <form type="lemma"><orth xml:lang="ka">განცხადებული</orth></form>
                    <sense><def xml:lang="ka">აშკარა, თვალით სახილველი.</def></sense>
                </entry>

                <entry xml:id="lex.gardadgoma">
                    <form type="lemma"><orth xml:lang="ka">გარდადგომა</orth></form>
                    <sense><def xml:lang="ka">გადაადგილება, ადგილის შეცვლა.</def></sense>
                </entry>

                <entry xml:id="lex.gonieri">
                    <form type="lemma"><orth xml:lang="ka">გონიერი</orth></form>
                    <sense><def xml:lang="ka">გონებით წარმოდგენილი, არამატერიალური.</def></sense>
                    <cit type="example"><quote xml:lang="ka">გრძნობადისა და გონიერისა ნათლისა განყოფილებად.</quote><bibl>ჰ. 3</bibl></cit>
                </entry>

                <entry xml:id="lex.grdznobadi">
                    <form type="lemma"><orth xml:lang="ka">გრძნობადი</orth></form>
                    <sense><def xml:lang="ka">შეგრძნებადი, მატერიალური.</def></sense>
                </entry>

                <entry xml:id="lex.gulvebadi">
                    <form type="lemma"><orth xml:lang="ka">გულვებადი</orth></form>
                    <etym><lang>grc</lang><mentioned xml:lang="grc">μέλλουσα</mentioned></etym>
                    <sense><def xml:lang="ka">მომავალი, მყოფადი.</def></sense>
                </entry>

                <!-- დ -->
                <entry xml:id="lex.dadgineba">
                    <form type="lemma"><orth xml:lang="ka">დადგინება</orth></form>
                    <sense><def xml:lang="ka">დაყენება, გაჩერება.</def></sense>
                </entry>

                <entry xml:id="lex.daknineba">
                    <form type="lemma"><orth xml:lang="ka">დაკნინება</orth></form>
                    <sense><def xml:lang="ka">დამცირება.</def></sense>
                </entry>

                <entry xml:id="lex.dambechdveli">
                    <form type="lemma"><orth xml:lang="ka">დამბეჭდველი</orth></form>
                    <sense><def xml:lang="ka">განმამტკიცებელი, დამმოწმებელი.</def></sense>
                </entry>

                <entry xml:id="lex.damtkhuevit">
                    <form type="lemma"><orth xml:lang="ka">დამთხუევით</orth></form>
                </entry>

                <entry xml:id="lex.dampqrobeli">
                    <form type="lemma"><orth xml:lang="ka">დამპყრობელი</orth></form>
                    <sense><def xml:lang="ka">ძლევამოსილი, გაბატონებული.</def></sense>
                </entry>

                <entry xml:id="lex.dasabami">
                    <form type="lemma"><orth xml:lang="ka">დასაბამი</orth></form>
                    <etym><lang>grc</lang><mentioned xml:lang="grc">ἐν ἀρχῇ</mentioned></etym>
                </entry>

                <entry xml:id="lex.dasatevneli">
                    <form type="lemma"><orth xml:lang="ka">დასატევნელი</orth></form>
                    <sense><def xml:lang="ka">შესაძლებელი.</def></sense>
                </entry>

                <entry xml:id="lex.datevna">
                    <form type="lemma"><orth xml:lang="ka">დატევნა</orth></form>
                </entry>

                <entry xml:id="lex.daqenebuli">
                    <form type="lemma"><orth xml:lang="ka">დაყენებული</orth></form>
                    <sense><def xml:lang="ka">აკრძალული, მიუღებელი.</def></sense>
                </entry>

                <entry xml:id="lex.daqofili">
                    <form type="lemma"><orth xml:lang="ka">დაყოფილი</orth></form>
                    <sense><def xml:lang="ka">დახშული, დახურული.</def></sense>
                </entry>

                <entry xml:id="lex.dajsna">
                    <form type="lemma"><orth xml:lang="ka">დაჴსნა</orth></form>
                    <sense><def xml:lang="ka">მოსპობა.</def></sense>
                    <cit type="example"><quote xml:lang="ka">რაჲთა საცთური დაჰჴსნას.</quote><bibl>ჰ. 10</bibl></cit>
                </entry>

                <entry xml:id="lex.dreka" corresp="http://purl.org/olia/olia.owl#Case">
                    <form type="lemma">
                        <orth xml:lang="ka">დრეკა</orth>
                        <orth type="variant" xml:lang="ka">დრეკაჲ</orth>
                    </form>
                    <sense>
                        <def xml:lang="ka">ბრუნება (სახელთა).</def>
                        <def xml:lang="en">Declension.</def>
                    </sense>
                    <cit type="example"><quote xml:lang="ka">სცავს თითოეული დრეკასა სახელთასა.</quote><bibl>§ 2</bibl></cit>
                    <cit type="example"><quote xml:lang="ka">ამას ეწოდების შობილობითი და ნათესაობითი დრეკაჲ სახელისაჲ.</quote><bibl>§ 9</bibl></cit>
                </entry>

                <!-- ე -->
                <entry xml:id="lex.ertpativi">
                    <form type="lemma"><orth xml:lang="ka">ერთ-პატივი</orth></form>
                    <sense><def xml:lang="ka">თანასწორპატივდებული.</def></sense>
                </entry>

                <entry xml:id="lex.ertkhmaoba">
                    <form type="lemma"><orth xml:lang="ka">ერთ-ჴმაობა</orth></form>
                    <sense><def xml:lang="ka">ერთიანობა, შეთანხმებულობა.</def></sense>
                </entry>

                <entry xml:id="lex.eksoria">
                    <form type="lemma"><orth xml:lang="ka">ექსორია</orth></form>
                    <etym><lang>grc</lang><mentioned xml:lang="grc">ἐξορία</mentioned></etym>
                    <sense><def xml:lang="ka">გაძევება.</def></sense>
                    <cit type="example"><quote xml:lang="ka">რაჲთა სიკუდილი ექსორია-ყოს.</quote><bibl>ჰ. 10</bibl></cit>
                </entry>

                <!-- ვ -->
                <entry xml:id="lex.vidreme">
                    <form type="lemma"><orth xml:lang="ka">ვიდრემე</orth></form>
                    <note>ნ. გვ 95.</note>
                </entry>

                <entry xml:id="lex.vrcelmetqueleba">
                    <form type="lemma"><orth xml:lang="ka">ვრცელ-მეტყუელება</orth></form>
                    <etym><lang>grc</lang><mentioned xml:lang="grc">μακρηγορία</mentioned></etym>
                    <sense><def xml:lang="ka">ვრცლად, გრძლად ლაპარაკი.</def></sense>
                </entry>

                <!-- თ -->
                <entry xml:id="lex.tanamoqmedi">
