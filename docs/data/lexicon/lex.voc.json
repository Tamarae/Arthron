  "attestations": [
    {
      "ref": "§ 7",
      "source": "treatise",
      "context": "ხოლო შობილობითად რაჲ იტყოდინიტყ̃დიან საზღვართაებრ მათთა…"
    },
    {
      "ref": "§ 8",
      "source": "treatise",
      "context": "ხოლო ორობითთათჳს ვითარღა ცხად-ვყოთ, რამეთუ არცა იგინი არიან ენასა ზედა…"
    },
    {
      "ref": "§ 11",
      "source": "treatise",
      "context": "ესრეთესე ორი ძალი აქუს ლექსსალექსაღ̃ისსა ამას და ერთითა გუარითა ითქუმის ორივე…"
    },
    {
      "ref": "§ 13",
      "source": "treatise",
      "context": "რამეთუ სამებისა სახელი დედალი არს და ითქუმის ესრეთ: ტრიას τριάς. ხოლო…"
    },
    {
      "ref": "§ 14",
      "source": "treatise",
      "context": "ხოლო ორობითნი არიან ესე: რაჟამს ორთა პირთა ცხად-ჰყოფდენჰყოფენ უართრონოდ: ტრიადე…"
    },
    {
      "ref": "§ 15",
      "source": "treatise",
      "context": "ხოლო მრავალთა რაჲ პირთა ცხად-ჰყოფდენ ადვილობითადადვილობითად და,…"
    },
    {
      "ref": "§ 17",
      "source": "treatise",
      "context": "და სულსა წმიდასა არა მამალი ეწოდების სახელი, არცა დედალი, არამედ შუაჲშუა.…"
    },
    {
      "ref": "§ 19",
      "source": "treatise",
      "context": "და ამათ ათცამეტთა ართრონთაგან ერთი ოდენ მხოლოდ შესაძლებელ არს ენისა ჩუენისაგან…"
    },
    {
      "ref": "კვლევა ე",
      "source": "research",
      "context": "ბრუნვის სახელწოდება შეესაბამება ბერძნულ κλητική. შანშოვანის გრამატიკაში…"
    }
  ]
