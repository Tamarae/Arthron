  "attestations": [
    {
      "ref": "§ 4",
      "source": "treatise",
      "context": "რამეთუ სამებისა ვიდრემე სახელი დედალი არს მათისაებრ ენისა, ხოლო ღმრთისაჲ…"
    },
    {
      "ref": "§ 5",
      "source": "treatise",
      "context": "ორობითთანიცაორობითნიცა ხუთნი არიან და განმრავლებითთანიცა; გარნა ორობითთასა…"
    },
    {
      "ref": "§ 8",
      "source": "treatise",
      "context": "ხოლო ორობითთათჳს ვითარღა ცხად-ვყოთ, რამეთუ არცა იგინი არიან ენასა ზედა…"
    },
    {
      "ref": "§ 9",
      "source": "treatise",
      "context": "ხოლო განმრავლებითთაგანმრავლებითა რაჲ იტყოდინიტყ̃დიან სახელთასახელსა ღმერთთასა,…"
    },
    {
      "ref": "§ 14",
      "source": "treatise",
      "context": "ხოლო ორობითნი არიან ესე: რაჟამს ორთა პირთა ცხად-ჰყოფდენჰყოფენ უართრონოდ: ტრიადე…"
    },
    {
      "ref": "§ 18",
      "source": "treatise",
      "context": "ეგრეთვე ორობითნი უართრონონი: პნევმატე πνεύματε, პნევმატჳნ πνευμάτοιν, პნევმატე…"
    },
    {
      "ref": "§ 20",
      "source": "treatise",
      "context": "ესრეთვე და დედალნი ართრონნი სამებისანი, ვითარმედ: ი სამებაჲ, ტის…"
    },
    {
      "ref": "¶ 16",
      "source": "research",
      "context": "მოქმედებითი ბრუნვის ფორმანტი -ით მრავალი სპეციალური ტერმინის საწარმოებლად არის…"
    },
    {
      "ref": "კვლევა ე",
      "source": "research",
      "context": "ბერძნული ტრადიციის მიხედვით, გრამატიკულ ტრაქტატში სახელთა და ართრონთათვის…"
    }
  ]
