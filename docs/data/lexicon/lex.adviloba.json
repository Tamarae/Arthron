  "attestations": [
    {
      "ref": "§ 4",
      "source": "treatise",
      "context": "რამეთუ სამებისა ვიდრემე სახელი დედალი არს მათისაებრ ენისა, ხოლო ღმრთისაჲ…"
    },
    {
      "ref": "§ 6",
      "source": "treatise",
      "context": "ვინაჲ პირველსავე სიტყუასა ზედა აღვიდეთ. რამეთუ რაჟამს, პირველადპირველად და…"
    },
    {
      "ref": "§ 15",
      "source": "treatise",
      "context": "ხოლო მრავალთა რაჲ პირთა ცხად-ჰყოფდენ ადვილობითადადვილობითად და,…"
    },
    {
      "ref": "¶ 16",
      "source": "research",
      "context": "მოქმედებითი ბრუნვის ფორმანტი -ით მრავალი სპეციალური ტერმინის საწარმოებლად არის…"
    },
    {
      "ref": "კვლევა ე",
      "source": "research",
      "context": "ბერძნულ ართრონთა და სიტყვათათვის დასახელებული ხუთი ბრუნვა შემდეგია: ადვილობითი…"
    }
