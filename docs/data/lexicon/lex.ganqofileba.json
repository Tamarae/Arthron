      "@type": "ontolex:LexicalSense",
      "skos:definition": [
        {
          "@value": "განსხვავებულობა, სხვადასხვაობა.",
          "@language": "ka"
        }
      ]
    }
  ],
  "attestations": [
    {
      "ref": "§ 10",
      "source": "treatise",
      "context": "რამეთუ ბერძულად განყოფილებაჲ აქუს მიცემითსა და მიზეზობითსა, ვითარცა ზემოზემოთ…"
    },
    {
      "ref": "ჰ. 3",
      "source": "homily",
      "context": "აწ უკუე გაჴსოვს, ვითარ მოაქუნდა სიტყუასა ჩუენსა გრძნობადისა და გონიერისა…"
    },
    {
      "ref": "ჰ. 31",
      "source": "homily",
      "context": "„ამას იტყჳს უფალი ყოვლისა მპყრობელი“. უფლად გესმა, ხოლო მამად გამოჩინებად არა…"
    },
    {
      "ref": "ჰ. 34",
      "source": "homily",
      "context": "გარნა იხილე, თუ რაჲ პოა მწვალებელთა სიბოროტემან, რამეთუ იტყჳან ვითარმედ: „თეოს“…"
    },
    {
      "ref": "ჰ. 40",
      "source": "homily",
      "context": "ამისთჳს უკუე იტყვს „პირველსა“ და „შემდგომად ამისსასა“, ვინაჲთგან მან მოსცა…"
    },
    {
      "ref": "ჰ. 53",
      "source": "homily",
      "context": "და ვითარმედ არა განსაგდებელად ძისა იტყოდა, ისმინე მისი მეტყუელისაჲ, ვითარმედ:…"
    },
    {
      "ref": "ჰ. 55",
      "source": "homily",
      "context": "აწ უკუე პავლე უძლურებისა მიმართ მსმენელთაჲსა მისწერს მოძღურებასა; ხოლო შენ…"
    }
  ]
}